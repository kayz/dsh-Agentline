{
  "name": "dsh-agentline",
  "version": "0.18.0",
  "description": "AgentLine for DSH：对话内派活（design→dev→CI→review）、worktree 队列、note/amendment/attention、任务状态与额度胶囊。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {},
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agentline",
    "multi-agent",
    "metrics"
  ],
  "license": "MIT"
}
